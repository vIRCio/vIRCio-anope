# ==========================================================
# JSON-RPC
# ==========================================================
#
# API oficial utilizada pelo site e automacoes vIRCio.
#
# Escuta via httpd/main em 127.0.0.1.
#
# O token plaintext fica fora do Anope.
# Aqui o Services recebe apenas o hash Bcrypt.
#

module
{
    name = "jsonrpc"

    # Compatibilidade com inteiros JavaScript.
    integer_bits = 53

    server = "httpd/main"

    token
    {
        token = "${env.ANOPE_RPC_TOKEN_HASH}"
        token_hash = "bcrypt"

        # Permite API geral e system.listMethods.
        # Bloqueia explicitamente rpc_message.
        methods = "~anope.message* anope.* system.*"
    }
}


# ==========================================================
# RPC DATA
# ==========================================================
#
# Consulta:
#   contas
#   canais
#   Services opers
#   servidores
#   usuarios
#

module
{
    name = "rpc_data"
}


# ==========================================================
# RPC USER
# ==========================================================
#
# Credenciais e execucao de comandos pela API.
#
# pretenduser permanece desligado.
#

module
{
    name = "rpc_user"

    pretenduser = no
}


# ==========================================================
# RPC SYSTEM
# ==========================================================
#
# Fornece system.listMethods.
#

module
{
    name = "rpc_system"
}


