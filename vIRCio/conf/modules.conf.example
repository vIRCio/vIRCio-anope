# ==========================================================
# HELP CHANNEL
# ==========================================================
#
# O modulo oficial helpchan aplica usermode +h quando um
# usuario recebe OP no canal configurado e possui OPME.
#
# Ele NAO remove automaticamente +h em deop, part ou perda
# de acesso.
#
# A vIRCio controla Helpers no InspIRCd atraves de
# m_vircio_ircops:
#
#   - +h; OU
#   - @op/superior em #Ajuda, #Help ou #vIRCio.
#
# Por isso helpchan permanece deliberadamente desabilitado.
#

#module
#{
#    name = "helpchan"
#
#    helpchannel = "#Ajuda"
#}


# ==========================================================
# HTTP LOCAL
# ==========================================================
#
# Backend HTTP para JSON-RPC.
#
# Somente localhost. Nunca expor diretamente na Internet.
# Acesso externo deve passar por proxy/tunnel.
#

module
{
    name = "httpd"

    httpd
    {
        name = "httpd/main"

        ip = "127.0.0.1"
        port = 8080

        timeout = 30
    }
}


