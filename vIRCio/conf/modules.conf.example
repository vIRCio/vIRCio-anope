# ==========================================================
# vIRCio STAFF SWHOIS
# ==========================================================
#
# O InspIRCd usa m_swhois_ext e o protocolo InspIRCd do
# Anope 2.1.27 detecta esse modulo automaticamente.
#
# O Anope suporta SWHOIS multiplo via specialwhois. O modulo
# usa a tag exclusiva vircio-services-staff e publica no WHOIS:
#
#   Services Root
#   Services Admin
#   Services Oper
#
# conforme o OperType real e valido da conta.
# Helper nao recebe SWHOIS deste modulo.
#

module
{
    name = "vircio_staffwhois"
}


# ==========================================================
# vIRCio DEFAULT TIMEZONE
# ==========================================================
#
# O ns_set_timezone oficial usa UTC quando a conta ainda nao
# escolheu timezone.
#
# A politica vIRCio e:
#
#   America/Sao_Paulo
#
# correspondente ao horario de Brasilia (UTC-3 atualmente).
#
# O modulo vircio_defaulttimezone reutiliza o extensible
# serializavel "timezone" de ns_set_timezone; nao cria formato
# de dados proprio. Ele preenche somente contas sem escolha
# explicita, inclusive contas carregadas no startup, e trata o
# reset sem argumento como America/Sao_Paulo imediatamente.
#

module
{
    name = "vircio_defaulttimezone"
}


# ==========================================================
# vIRCio ZOMBIE / GRINGO
# ==========================================================
#
# Disponibiliza somente a acao autorizada ZOMBIE ADD|DEL. O
# ZombieServ e a frente de menor privilegio para ZombieGringo:
# ele evita o bloqueio opersonly do OperServ sem transformar o
# scanner em IRCop. Services Admin e Services Root mantem o
# comando OperServ para administracao humana.
#
# O InspIRCd m_vircio_zombie impoe +Z, #vIRCio e a liberacao
# automatica apos autenticacao. Este modulo nao faz scanning,
# GeoIP, DNSBL ou politica de IP.
#

module
{
    name = "vircio_zombie"
}

service
{
    nick = "ZombieServ"
    user = "zombieserv"
    host = "services.vircio.net"
    real = "vIRCio Zombie quarantine service"
}

command
{
    service = "ZombieServ"
    name = "HELP"
    command = "generic/help"
}

command
{
    service = "ZombieServ"
    name = "ZOMBIE"
    command = "operserv/zombie"
    permission = "operserv/zombie"
}

command
{
    service = "OperServ"
    name = "ZOMBIE"
    command = "operserv/zombie"
    permission = "operserv/zombie"
}


